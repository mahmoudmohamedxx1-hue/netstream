# Database (SQLite)
# IMPORTANT: point this at a path OUTSIDE the project directory (e.g. an
# absolute path like /home/<user>/netstream-data/custom.db). The Next.js dev
# server watches the whole project tree — every SQLite write inside it
# triggers a rebuild + hot refresh that REMOUNTS the whole app (the video
# player loses its state mid-playback on every watch-history update).
DATABASE_URL=file:/absolute/path/outside/the/project/custom.db

# TMDB API Key (get yours free at https://developer.themoviedb.org/docs)
# Optional — the app has a built-in default key
TMDB_API_KEY=your_tmdb_api_key_here
